# Copy to .env and fill in. Never commit the real file (it's gitignored).

## Creditcoin CC3 Testnet
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"

## Ethereum Sepolia — get an RPC URL from Infura/Alchemy (free tier is enough)
SOURCE_CHAIN_RPC_URL=""

## Source chain key on Creditcoin for Sepolia. This is Creditcoin-internal,
## NOT the EVM chainId (11155111). Confirmed live via spikes/01-chain-info.ts.
SOURCE_CHAIN_KEY=1

## Single wallet, same address/key works on both networks (both are EVM).
## CAUTION: testnet-only throwaway key. Fund via faucets, never reuse a real wallet.
CREDITCOIN_WALLET_PRIVATE_KEY=""

## Pre-deployed Gluwa test infra reused for the Phase 1 spike only — our own
## OrderBook.sol replaces this in Phase 3.
SOURCE_CHAIN_CONTRACT_ADDRESS="0x0F24FD9e0524BA53d3f0A4A40350Adf5370b4A53"
EVM_V1_DECODER_LIBRARY_ADDRESS="0x04B9ae8562D8Cc5bbbBbBB759080dDC30B56D18B"

## Optional — only needed to run `forge script ... --verify` on Sepolia (Phase 3+).
ETHERSCAN_API_KEY=""

## Faction March's own contracts (Phase 3/4). See README.md for current addresses.
ORDER_BOOK_ADDRESS="0xA100d72A7F214D669AC3deCEb07E6b35C001fE7F"
PROOF_GATE_ADDRESS="0x58ef7793d058d7F2e11DCe57747bEf6D1d487778"

FACTION_MARCH_ADDRESS="0xB8Fde830fF968E56528539505243da22ce59b628"

WAR_CHEST_ADDRESS="0xF1eD07B6A8406E2b0B7D8FE072C64740aCdf24C4"
